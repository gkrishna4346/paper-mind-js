# Paper Mind AI — copy this file to ".env" and fill in ONE key.
# Priority if several are set: Gemini → Anthropic → Hugging Face (override with LLM_PROVIDER).

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Optional
# LLM_PROVIDER=gemini        # gemini | anthropic | huggingface
# PORT=5050
# MAX_UPLOAD_MB=20
# DOC_TTL_MINUTES=60
